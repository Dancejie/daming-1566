  "scenes": [
    {
      "id": "O01",
      "title": "周云逸之后",
      "location": "嘉靖三十九年冬 · 京城文书值房",
      "context": "连年用兵、灾荒与宫中支出叠在一起。无雪使财政困境又变成君臣之间不能轻说的事。",
      "shotId": "R01",
      "beats": [
        {
          "id": "O01.01",
          "type": "narration",
          "text": "一冬无雪。屋檐下的水缸结了薄冰，宫门外的地面却仍是干的。你压住一叠待抄的支用册，听见门外的脚步忽然停住。",
          "shotId": "R01"
        },
        {
          "id": "O01.02",
          "type": "narration",
          "text": "在这个讲天人感应的朝廷，雨雪不是闲话。一个官员把天象与政事连在一起说，就可能被问：这句话究竟冲着谁？"
        },
        {
          "id": "O01.03",
          "type": "narration",
          "text": "钦天监监正周云逸因进谏获罪，已死于廷杖。消息送到文书房时，没人敢追问刑场的情形，众人先把案上有关奏议的纸收了起来。"
        },
        {
          "id": "O01.04",
          "type": "narration",
          "text": "你不是进言的大臣，也不在刑场。你只知道，明年的开支仍要议；去年没有填上的亏空，也不会因为一个人死去就消失。"
        },
        {
          "id": "O01.05",
          "type": "narration",
          "text": "年末的账分作几摞：宫用、河工、军需，以及地方送来的灾情。每一摞都有人签过字，却没有一摞愿意替别处认下差额。"
        },
        {
          "id": "O01.06",
          "type": "narration",
          "text": "同房的老书办把你的砚往里推了推：“传闻别入账。可亲手经办过的，也别等别人来替你记。”"
        },
        {
          "id": "O01.07",
          "type": "choice",
          "text": "明日整理随堂底册，你先做哪一件？",
          "options": [
            {
              "id": "opening.sources",
              "label": "逐项注明账目来处",
              "playerText": "先把哪一衙门送来、哪一日收到写清。",
              "responseText": "你在封面里页另列交收记录。后来的问话有了落点，你也成为能被传问的人。",
              "responseSpeaker": "player",
              "effects": {
                "stats": {
                  "evidence": 8,
                  "risk": 3,
                  "credibility": 4
                },
                "memory": {
                  "key": "firstConcern",
                  "text": "你最早留心的是：每一笔账究竟从哪里来。"
                }
              },
              "requires": [],
              "consequence": "账证完整 +8；自身风险 +3；经手可信 +4"
            },
            {
              "id": "opening.need",
              "label": "把急用与积欠分开",
              "playerText": "军前急需另列，旧日积欠不混进去。",
              "responseText": "你没有替任何一笔销账，只把时限分清。上头若要合并，总得再问一次。",
              "responseSpeaker": "player",
              "effects": {
                "stats": {
                  "fiscal": 8,
                  "credibility": 4
                },
                "memory": {
                  "key": "firstConcern",
                  "text": "你最早留心的是：急用不能掩掉旧欠。"
                }
              },
              "requires": [],
              "consequence": "财政理解 +8；经手可信 +4"
            },
            {
              "id": "opening.people",
              "label": "附上地方灾情摘要",
              "playerText": "钱粮的册子旁，也该有地方正在挨饿的情形。",
              "responseText": "摘要另夹一页，没有挤进正式账项。它能否被看见，还取决于谁肯把它递上去。",
              "responseSpeaker": "player",
              "effects": {
                "stats": {
                  "people": 8,
                  "risk": 4
                },
                "memory": {
                  "key": "firstConcern",
                  "text": "你最早留心的是：账页之外还有百姓的饭。"
                }
              },
              "requires": [],
              "consequence": "民食关切 +8；自身风险 +4"
            }
          ]
        },
        {
          "id": "O01.08",
          "type": "narration",
          "text": "旧年过去，皇帝斋戒祈雪。你被点名随账册入西苑，只负责取件、誊录、对照。你可以说清账从何来，却不能替任何大臣作主。"
        }
      ],
      "stageCharacter": "player",
      "background": "/original/assets/anchors/xiyuan-fiscal-room-v2.png"
    },
    {
      "id": "O02",
      "title": "雪落西苑",
      "location": "嘉靖四十年正月 · 西苑外廊",
      "context": "雪带来祥瑞的说法，也改变了会议上的气势；财政缺口仍在，周云逸的所谓后台仍是威胁。",
      "shotId": "R02",
      "beats": [
        {
          "id": "O02.01",
          "type": "narration",
          "text": "议财的日子将近，西苑终于落雪。廊下有人抬头，随即把笑意收住：报喜有报喜的次序，抢在谁前面，也是规矩。",
          "shotId": "R02"
        },
        {
          "id": "O02.02",
          "type": "narration",
          "text": "司礼监管的是皇帝身边的文书与传达。吕芳居掌印的位置，冯保还得看他的脸色。同一场雪，在宫里既是天象，也是升降进退的机会。"
        },
        {
          "id": "O02.03",
          "type": "dialogue",
          "text": "内阁诸臣入苑，披风上落着细雪。徐阶停在廊内，将你手中的底册往灯下移了移。",
          "speaker": "xujie",
          "emotion": "base"
        },
        {
          "id": "O02.04",
          "type": "dialogue",
          "text": "“听见什么，不等于知道什么。你随堂，只把谁说了哪一项记准。”他说完便向门里走，没有许诺会替你挡住所有问话。",
          "speaker": "xujie",
          "emotion": "base"
        },
        {
          "id": "O02.05",
          "type": "narration",
          "text": "严嵩为首辅，许多政务经他转呈；徐阶、高拱、张居正靠近裕王一边，却各有要保住的人和事。有人等着问账，也有人等着把问账说成攻击皇帝。"
        },
        {
          "id": "O02.06",
          "type": "narration",
          "text": "嘉靖很久不临常朝，却仍控制谁能奏、谁能批、谁来担责。御座暂空，也不等于他听不见。你被安排在外案，低头整理纸笔。"
        },
        {
          "id": "O02.07",
          "type": "dialogue",
          "text": "“若有人追问周云逸的话是谁授意，你只答你亲见的。”徐阶没有再说下去。雪水从你的袖口滴到地上。",
          "speaker": "xujie",
          "emotion": "base"
        },
        {
          "id": "O02.08",
          "type": "choice",
          "text": "你在随堂笔记首页留下怎样的提醒？",
          "options": [
            {
              "id": "record.separate",
              "label": "将亲见与转述分栏",
              "playerText": "未经核对的话，先记为转述。",
              "responseText": "你留出两栏。以后有人要把传闻写成定论，纸上就会出现一次可追问的改动。",
              "responseSpeaker": "xujie",
              "effects": {
                "stats": {
                  "credibility": 8,
                  "evidence": 4
                },
                "relationships": {
                  "xujie": 1
                },
                "flags": {
                  "carefulRecord": true
                }
              },
              "requires": [],
              "consequence": "经手可信 +8；账证完整 +4"
            },
            {
              "id": "record.context",
              "label": "连同话前话后记录",
              "playerText": "只抄一句，容易把意思抄反；我把前后议项也记上。",
              "responseText": "徐阶点了一下账册的封面，让你把议项与出处相对。多记一层，也就多担一层经手。",
              "responseSpeaker": "xujie",
              "effects": {
                "stats": {
